{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sundaytranslate",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "translate.sundaysuite.app", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // Workers AI — phase 2 (Whisper STT) + phase 3 (TTS). Free of per-request
  // setup; the route guards on the binding being present.
  "ai": { "binding": "AI" },
  // Public config the SERVER reads at RUNTIME. NEXT_PUBLIC_* are inlined into the
  // CLIENT bundle at build, but server code (lib/supabase/service.ts,
  // lib/server/broadcast.ts) reads process.env.* inside the Worker — where
  // build-time inlining does NOT reach — so they must be declared here, or
  // host-start (POST /api/sessions) throws "Supabase env missing" → 500. These
  // are public values (the anon key is designed to be public).
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://rkiahljrkormwzogghpc.supabase.co",
    // OPTIONAL Sunday-Account host login. The SERVER (middleware) reads these at
    // runtime in the Worker, so they must live here as well as in the client
    // bundle. Public values (issuer URL + anon key are designed to be public).
    // Fill the issuer project ref + anon key before enabling host login.
    "NEXT_PUBLIC_SUNDAY_AUTH_URL": "https://REPLACE-issuer-ref.supabase.co",
    "NEXT_PUBLIC_SUNDAY_AUTH_ANON_KEY": "REPLACE-issuer-anon-key",
    "NEXT_PUBLIC_COOKIE_DOMAIN": ".sundaysuite.app"
  }
  // Runtime SECRETS (set once via wrangler, never committed):
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY   # REQUIRED — host-start needs it
  //   npx wrangler secret put CF_REALTIME_APP_ID          # audio transport (phase 1 audio)
  //   npx wrangler secret put CF_REALTIME_APP_TOKEN
  //   npx wrangler secret put ANTHROPIC_API_KEY           # phase 2 captions (optional)
  //   npx wrangler secret put TRANSLATE_ADMIN_EMAILS      # host allowlist (the one authz gate)
}
