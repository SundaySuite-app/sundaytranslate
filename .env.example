# Supabase — DATA project: shared "Sunday" project (rkiahljrkormwzogghpc),
# dedicated `translator` schema. UNCHANGED by the host-login feature.
# After running the migration, EXPOSE the schema:
#   Dashboard → Settings → API → Exposed schemas → add `translator` → Save
NEXT_PUBLIC_SUPABASE_URL=https://rkiahljrkormwzogghpc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── OPTIONAL host login (Sunday Account) ─────────────────────────────────────
# Identity lives on the suite-wide ISSUER Supabase project (the Sunday Account),
# a DIFFERENT project than the DATA one above. Listeners/source/interpreter stay
# anonymous + code-based; this only powers the /host dashboard. If these are
# unset, /host simply can't sign anyone in — the rest of the app is unaffected.
NEXT_PUBLIC_SUNDAY_AUTH_URL=https://<issuer-project-ref>.supabase.co
NEXT_PUBLIC_SUNDAY_AUTH_ANON_KEY=eyJ...
# Parent domain so one Sunday login is shared across *.sundaysuite.app.
# Leave UNSET in local dev (cookies must stay on localhost).
NEXT_PUBLIC_COOKIE_DOMAIN=.sundaysuite.app
# The ONE authorization gate (fail-closed): comma/space-separated allowlist of
# operatør emails permitted to be hosts. Empty = nobody can host. SERVER ONLY.
TRANSLATE_ADMIN_EMAILS=deg@menigheten.no

# Public base URL used to build join URLs + QR codes.
NEXT_PUBLIC_BASE_URL=https://translate.sundaysuite.app

# Cloudflare Realtime SFU app (audio transport). Create a Realtime app in the
# Cloudflare dashboard → App ID + App Token. The token is SERVER-ONLY (the
# /api/rt/* routes proxy the SFU with it; it never reaches the browser).
#   npx wrangler secret put CF_REALTIME_APP_ID
#   npx wrangler secret put CF_REALTIME_APP_TOKEN
CF_REALTIME_APP_ID=
CF_REALTIME_APP_TOKEN=

# Optional ICE override (client-side). Default is Cloudflare STUN, which is
# enough when listeners can reach the SFU directly. For restrictive church wifi
# or cellular, paste a JSON array of RTCIceServer including a Cloudflare TURN
# entry (generate via the Realtime TURN API) — no code change needed.
#   e.g. [{"urls":"stun:stun.cloudflare.com:3478"},{"urls":"turn:turn.cloudflare.com:3478?transport=udp","username":"...","credential":"..."}]
NEXT_PUBLIC_RT_ICE=

# Phase 2 (AI captions): Anthropic key for server-side translation, reusing the
# SundayStage translation pattern. Optional — with no key, captions degrade to
# "AI unavailable" and human interpretation is unaffected. SERVER ONLY.
#   npx wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
